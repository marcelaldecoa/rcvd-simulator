{
  "compilerOptions": {
    "composite": true,
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": true,
    "skipLibCheck": true,
    "noEmit": true,
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "paths": {
      "@/*": ["./src/renderer/src/*"],
      "@core/*": ["./src/core/*"],
      "@telemetry/*": ["./src/telemetry/*"]
    }
  },
  "include": [
    "src/renderer/src/**/*",
    "src/renderer/overlay/**/*",
    "src/core/**/*",
    "src/telemetry/**/*",
    "src/preload/*.d.ts"
  ]
}
